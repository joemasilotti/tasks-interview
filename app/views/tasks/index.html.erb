<h1 class="text-2xl font-bold mb-4">Tasks</h1>

<div class="flex flex-col gap-y-8">
  <%- @tasks.each do |task| %>
    <div class="flex gap-x-8">
      <%- if task.completed_at? %>
        <%= button_to "Undo", task_completion_path(task), method: :delete, class: "btn" %>
      <%- else %>
        <%= button_to "Complete", task_completion_path(task), class: "btn" %>
      <%- end %>
      <h2 class="<%= class_names("text-lg font-semibold shrink-0", "line-through": task.completed_at?) %>"><%= task.title %></h2>
      <div><%= task.completed_at? ? "Complete" : "Incomplete" %></div>
      <div class="italic"><%= task.description&.truncate(50) %></div>
      <div><%= task.assignee&.name %></div>
      <div class="flex gap-x-2">
        <%= link_to "Edit", edit_task_path(task) %>
        <%= link_to "Delete", task_path(task), data: { turbo_method: "delete" } %>
      </div>
    </div>
  <%- end %>
</div>

<hr class="my-8" />

<%= render partial: "form", locals: { task: @task } %>
